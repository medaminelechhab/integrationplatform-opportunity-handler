<?xml version="1.0" encoding="UTF-8"?>

<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <server>
            <id>nexus</id>
            <username>${env.NEXUS_LOGIN}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>inhouse.snapshot</id>
            <username>${env.NEXUS_LOGIN}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>inhouse</id>
            <username>${env.NEXUS_LOGIN}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>
    <mirrors>

        <mirror>
            <id>Nexus.proxy.central</id>
            <mirrorOf>central</mirrorOf>
            <name>Nexus Proxy mirroring central (maven 2) repository</name>
            <!-- <url>https://nexus-ein.com.intraMyProject/service/rest/repository/browse/proxy-maven/</url> -->
            <url>https://nexus-ein.com.intraMyProject/repository/proxy-maven/</url>
        </mirror>

    </mirrors>

</settings>
